NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Calendar connection requires both values; appointment synchronization is not yet available.
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDAR_TOKEN_KEY=
SESSION_SECRET=
DATABASE_URL=
# Only for the optional local PostgreSQL container; never use production data.
POSTGRES_DB=kotailor
POSTGRES_USER=kotailor
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Set only when the deployment is behind a trusted reverse proxy.
# TRUST_PROXY=loopback
